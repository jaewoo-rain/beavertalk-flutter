# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

.packages
build/
.flutter-plugins

.claude
.mcp.json
docs
.env
# FCM 테스트용 서비스 계정 키 (절대 커밋 금지)
tools/service-account.json
service-account.json
google-services.json
# 벤더링한 flutter_pcm_sound 의 로컬 Gradle 캐시 (빌드 산출물)
packages/**/.gradle/
# 자산 교체 전 백업 — 로컬 전용(레포에 영상 사본을 쌓지 않는다)
backup_old_assets/

# 로컬 전용 백업 — 공개 저장소라 .env 사본이 실수로 올라가면 그대로 유출이다
*.bak
.env.bak*

# 업로드 키스토어 — 잃으면 앱 업데이트가 영구 불가하고, 새면 위조 서명이 가능하다.
# android/.gitignore 가 android/ 아래를 이미 막지만, 저장소 루트에 잘못 만드는
# 사고를 대비해 여기서 한 번 더 막는다(실측: 루트 경로는 안 막히고 있었다).
*.jks
*.keystore
key.properties
