<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- vosk_flutter_2 declares minSdk 30 (Android 11), but the Pronunciation
         Challenge already degrades to tap input whenever STT can't initialize
         (SttService.init try/catch → tap fallback). Rather than raise the whole
         app's floor to 30 (which would drop every Android 10 user for one
         mini-game), override the library so the app keeps minSdk 29; on Android
         10 the Vosk model just fails to load and the game stays playable by tap.
         Trade-off documented in docs/ — revisit if an Android-10-safe STT
         engine (or a bundled model path) is adopted. -->
    <uses-sdk tools:overrideLibrary="org.vosk.vosk_flutter"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 발음 챌린지 — 전면 카메라 셀피 배경 (camera 플러그인) -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- 인바운드 콜(로컬 트리거) — flutter_callkit_incoming 수신 화면/부재중 알림용 -->
    <!-- Android 13+ 알림 표시 권한(부재중 배너 + 수신 알림) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 잠금화면 위 전체화면 수신 표시(Android 14+는 런타임 승인도 필요) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- 수신 시 화면/CPU 깨우기 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 통화 진행 중 포그라운드 서비스(마이크) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <application
        android:label="beavertalk"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase OAuth (Kakao, and the Apple/Android fallback) deep-link
                 redirect. After browser consent the external browser returns to
                 the app via this scheme/host; supabase_flutter then completes the
                 session. Must match kOAuthRedirect in auth_controller.dart and the
                 Supabase dashboard's Redirect URLs. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="im.beavertalk.beavertalk" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Disable Flutter's built-in deep-link routing so the Supabase OAuth
             callback (im.beavertalk.beavertalk://login-callback?code=…) is NOT
             pushed onto the Navigator as an unknown route (which showed the
             "화면 준비 중" placeholder). With this off, supabase_flutter's own
             app_links listener receives the link and completes the PKCE code
             exchange → session → AuthGate. In-app Navigator.pushNamed is
             unaffected (this only governs OS-delivered links). -->
        <meta-data
            android:name="flutter_deeplinking_enabled"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
