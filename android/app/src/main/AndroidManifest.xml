<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- vosk_flutter_2 declares minSdk 30 (Android 11), but the Pronunciation
         Challenge already degrades to tap input whenever STT can't initialize
         (SttService.init try/catch → tap fallback). Rather than raise the whole
         app's floor to 30 (which would drop every Android 10 user for one
         mini-game), override the library so the app keeps minSdk 29; on Android
         10 the Vosk model just fails to load and the game stays playable by tap.
         Trade-off documented in docs/ — revisit if an Android-10-safe STT
         engine (or a bundled model path) is adopted. -->
    <uses-sdk tools:overrideLibrary="org.vosk.vosk_flutter"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 발음 챌린지 — 전면 카메라 셀피 배경 (camera 플러그인) -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- 인바운드 콜(로컬 트리거) — flutter_callkit_incoming 수신 화면/부재중 알림용 -->
    <!-- Android 13+ 알림 표시 권한(부재중 배너 + 수신 알림) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 잠금화면 위 전체화면 수신 표시(Android 14+는 런타임 승인도 필요) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- 수신 시 화면/CPU 깨우기 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 통화 진행 중 포그라운드 서비스(마이크) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- 백그라운드 알람(앱이 꺼져 있어도 정해진 시각에 수신 화면) — AlarmManager
         정확 알람. USE_EXACT_ALARM(알람시계류, 13+ 자동 승인) + SCHEDULE_EXACT_ALARM(12). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <application
        android:label="beavertalk"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 백그라운드 알람 수신기: 정확 알람 발화(explicit PendingIntent) + 재부팅/
             시간변경/앱갱신 시 재스케줄. ALARM_FIRE는 명시적 인텐트라 필터 불필요. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
